{
  "name": "fidget-spinner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "손가락으로 튕겨 돌리는 햅틱 피젯 스피너 (Android Chrome 전용 PWA)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/check-bundle-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit",
    "verify:full": "npm run verify && npm run format:check && npm run build && npm run test:e2e && npm run test:perf"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
